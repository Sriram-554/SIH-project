# Heavy Remote Sensing Datasets (>100MB / raw satellite products)
# Keep directory structure with .gitkeep
data/*.SAFE/
data/*.SAFE
data/*.SAFE.zip
data/*.zip
data/*.jp2
data/*.tif
data/*.tiff
!data/.gitkeep
!data/README.md

# Optional temporary outputs / cache
# Keep outputs folder with .gitkeep
!outputs/.gitkeep
